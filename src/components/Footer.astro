---
import { SITE, type Lang } from "../site";
import { COPY } from "../copy";

interface Props { lang: Lang }
const t = COPY[Astro.props.lang].footer;
---
<footer>
  <div class="wrap row">
    <p class="brand mono"><span>~/</span>ai-agent-audit</p>
    <p class="fine">
      {t.disclaimer}{" "}
      © 2026 <a href={SITE.authorUrl} rel="noopener">{SITE.author}</a>{" · "}
      <a href={SITE.repo} rel="noopener">GitHub</a>{" · "}
      <a href={SITE.landingRepo} rel="noopener">{t.siteCode}</a>{" · "}
      <a href={SITE.sibling} rel="noopener">security-audit.dev</a>{" · "}
      MIT · {t.noTracking}
    </p>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--rule); padding-block: 28px 40px; }
  .row { display: flex; flex-wrap: wrap; gap: 10px 32px; align-items: baseline; justify-content: space-between; }
  .brand { font-weight: 600; }
  .brand span { color: var(--accent); }
</style>
